<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash / Welcome Screen Layout
    Background: deep navy (#0b1437)
    Colors: gold (#f7bc35), white
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:gravity="center">

    <!-- ── Decorative top-right circle ─────────────────────── -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/circle_decoration_top" />

    <!-- ── Decorative bottom-left circle ───────────────────── -->
    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="-40dp"
        android:layout_marginStart="-40dp"
        android:background="@drawable/circle_decoration_bottom" />

    <!-- ── CENTER CONTENT ───────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/splash_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp">

        <!-- Airplane icon -->
        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_airplane"
            android:tint="@color/gold"
            android:contentDescription="شعار وكالة أبو منية" />

        <!-- App name in Arabic -->
        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="وكالة أبو منية"
            android:textColor="@color/gold"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.02" />

        <!-- Gold divider -->
        <View
            android:id="@+id/splash_divider"
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:background="@color/gold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="للسياحة والسفر"
            android:textColor="#CCFBDF97"
            android:textSize="18sp"
            android:fontFamily="sans-serif"
            android:gravity="center" />

    </LinearLayout>

    <!-- ── TAGLINE at bottom ────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✈  سافر معنا إلى كل مكان  ✈"
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.04" />

        <!-- Loading dots indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/dot_active" />
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/dot_inactive" />
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/dot_inactive" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
